# --- AI 解説機能の設定 ---
#
# このファイルを `.env.local` にコピーし、必要なキーを記入してください。
# `.env.local` は git にコミットされません(.gitignore で除外)。
#
# ★ 機能フラグ: 既定では完全に無効(ボタン非表示・API 404)。
#   有効にするには下の 2 つの変数を両方 "true" に設定してください。
#
#   - NEXT_PUBLIC_AI_ENABLED  クライアント側のボタン表示制御
#   - AI_ENABLED              サーバー側の API 受付制御
#
# Vercel 等にデプロイする場合: ダッシュボードの Environment Variables に
# 同じ 2 つを追加してから Redeploy してください。

# === 機能フラグ(既定 OFF) ===
# NEXT_PUBLIC_AI_ENABLED=true
# AI_ENABLED=true

# Provider 選択: openai (デフォルト) | anthropic | google
AI_PROVIDER=openai

# モデル名(Provider ごとのデフォルト):
# - OpenAI:    gpt-4o-mini, gpt-4o, gpt-5
# - Anthropic: claude-haiku-4-5-20251001, claude-sonnet-4-6, claude-opus-4-7
# - Google:    gemini-2.0-flash, gemini-1.5-pro
# AI_MODEL=gpt-4o-mini

# === API キー(使う Provider に応じて 1 つだけ設定) ===
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_AI_API_KEY=AIza...

# === レート制限 ===
# 1 IP あたり 1 日の利用回数(デフォルト 10)
# AI_DAILY_USER_LIMIT=10

# サイト全体での 1 ヶ月の利用回数(デフォルト 1000)
# 想定: GPT-4o mini で約 $1〜2 / 月の費用感
# AI_MONTHLY_GLOBAL_LIMIT=1000

# 強制デモモード(キーがあってもモックを返す)
# AI_DEMO_MODE=true

# === Google AdSense ===
# AdSense の発行者 ID。"ca-pub-XXXXXXXXXXXXXXXX" 形式。
# 設定しない (空 or 未定義) と AdSense スクリプト・広告枠は表示されません。
# 取得元: https://www.google.com/adsense/  → アカウント → ヘッダーに表示される ID
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# === Google Analytics ===
# 既存の GA4 ID（"G-XXXXXXXXXX" 形式）。設定すれば components/GoogleAnalytics で読込まれる。
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
